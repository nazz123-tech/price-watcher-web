# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Everything starting with NEXT_PUBLIC_ is visible in the browser,
# so the Supabase service key must NEVER go here.

# Our backend, e.g. https://price-watcher-api.onrender.com (http://localhost:4000 locally)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase: Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
